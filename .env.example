DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
# 当前实测支持 deepseek-flash / deepseek-v4-pro，明确选模型，不使用 claude-* 映射名。
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
# Claude线路当前仅核定此固定版本；没有美元调用授权时不会联网。
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DeepSeek：每日人民币预算；Anthropic/OpenAI：每日美元合计预算。
# 两种币种独立记账，不自动换汇。0 表示禁止该线路真实调用。
DAILY_BUDGET_CNY=
DAILY_BUDGET_USD=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=
# 仅本地演示身份入口；显式true启用，默认关闭。
DEMO_MODE=
# 可选观测：Langfuse项目密钥，与模型API key无关；OpenTelemetry本身不用申请key。
# 填完整后仍需显式 --trace-cloud 才上传脱敏记录，不自动外发全文。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 项目所在区域的服务首页URL，不含 /api/public/otel 路径。
LANGFUSE_BASE_URL=
