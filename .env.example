DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
# 当前实测支持 deepseek-flash / deepseek-v4-pro，明确选模型，不使用 claude-* 映射名。
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
# Claude线路当前仅核定此固定版本；没有美元调用授权时不会联网。
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DeepSeek：每日人民币预算；Anthropic/OpenAI：每日美元合计预算。
# 两种币种独立记账，不自动换汇。0 表示禁止该线路真实调用。
DAILY_BUDGET_CNY=
DAILY_BUDGET_USD=
# V2 真实数据：仅实时模式使用，填入配置不代表授权真实联调。
# Google Key 需启用 Geocoding API、Places API (New)、Routes API。
GOOGLE_MAPS_API_KEY=
# 乐天 applicationId、accessKey；affiliateId 可选，没有就留空。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# 乐天应用后台允许的网站完整 URL，用于 Referer 请求头
RAKUTEN_REFERER=
# V2 会话保留天数，默认 30；以下保护将在 V2 实施时接入。
DEMO_TOKEN_DAYS=
# 外部 API 每日调用上限，默认分别为 50 / 25 / 150 / 150 / 200。
GOOGLE_GEOCODE_DAILY_CAP=
GOOGLE_PLACES_DAILY_CAP=
GOOGLE_ROUTES_DAILY_CAP=
RAKUTEN_DAILY_CAP=
WEATHER_DAILY_CAP=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=
# 仅本地演示身份入口；显式true启用，默认关闭。
DEMO_MODE=
# 可选观测：Langfuse项目密钥，与模型API key无关；OpenTelemetry本身不用申请key。
# 填完整后仍需显式 --trace-cloud 才上传脱敏记录，不自动外发全文。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 项目所在区域的服务首页URL，不含 /api/public/otel 路径。
LANGFUSE_BASE_URL=
